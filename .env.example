# Sao chép file này thành .env.local (trên VPS: file .env) rồi điền giá trị thật.
# KHÔNG commit file .env / .env.local lên Git (đã có trong .gitignore).

# Mật khẩu để đăng nhập /admin. Đặt mật khẩu mạnh, không dùng giá trị mẫu này.
ADMIN_PASSWORD=doi-mat-khau-nay

# Chuỗi bí mật dùng để ký phiên đăng nhập admin. Chạy lệnh sau để tạo 1 chuỗi
# ngẫu nhiên rồi dán vào đây:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien

# (Tuỳ chọn) Bật nút "Dịch tự động → EN" trong /admin — chỉ cần điền 1 trong
# 2 key dưới đây. Nếu để trống, nút dịch sẽ báo lỗi hướng dẫn cấu hình,
# các trang vẫn hoạt động bình thường (bạn tự nhập tay ô "(EN)").
#
# Ưu tiên 1 — Anthropic (Claude): dịch có ngữ cảnh, phù hợp thuật ngữ dầu khí,
# lấy key tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Ưu tiên 2 — DeepL (dùng nếu không có ANTHROPIC_API_KEY):
# lấy key tại https://www.deepl.com/pro-api (key Free có hậu tố ":fx")
DEEPL_API_KEY=
